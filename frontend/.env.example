# Leave blank to use the Vite dev proxy (/api -> http://127.0.0.1:8000).
# REQUIRED in production: the frontend and backend deploy as two separate
# Vercel projects (there's no dev proxy in a static Vercel deployment), so
# set this to your backend project's URL, e.g.
# VITE_API_BASE_URL=https://your-api.vercel.app
VITE_API_BASE_URL=

# OAuth 2.0 Web Client ID from https://console.cloud.google.com/apis/credentials
# (must match the backend's GOOGLE_CLIENT_ID exactly). Leave blank to hide the
# "Continue with Google" button on the Login/Register pages.
VITE_GOOGLE_CLIENT_ID=
