# Leave blank to use the Vite dev proxy locally (/api -> http://127.0.0.1:8000),
# and leave blank in production too if deploying via the root vercel.json's
# Vercel Services setup (frontend + backend as one project, one domain --
# /api/* already routes to the backend service on the same origin, so relative
# "/api/..." calls just work with no base URL needed).
# Only set this if the backend is deployed as a separate project/domain instead,
# e.g. VITE_API_BASE_URL=https://your-api.vercel.app
VITE_API_BASE_URL=

# OAuth 2.0 Web Client ID from https://console.cloud.google.com/apis/credentials
# (must match the backend's GOOGLE_CLIENT_ID exactly). Leave blank to hide the
# "Continue with Google" button on the Login/Register pages.
VITE_GOOGLE_CLIENT_ID=

# VAPID public key for Web Push (background notifications in the installed
# PWA -- Settings page "Enable push on this device"). Must equal the
# backend's VAPID_PUBLIC_KEY exactly (generate once with
# `npx web-push generate-vapid-keys`). Leave blank to hide the push UI;
# everything else keeps working.
VITE_VAPID_PUBLIC_KEY=
