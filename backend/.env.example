# Copy to `.env` for local dev, or set these directly in your host's
# environment-variable settings (e.g. Vercel Project Settings -> Environment
# Variables) for a real deployment. Nothing here is required to boot the app
# locally -- every value has a safe dev-mode fallback (see app/security.py,
# app/database.py, app/uploads.py, app/email_utils.py).

# ---------------------------------------------------------------------
# Database (app/database.py)
# ---------------------------------------------------------------------
# Leave blank to use a local SQLite file (backend/dashboard.db). Set to a
# Postgres connection string (e.g. from Supabase) for any real deployment.
# On Vercel specifically, use Supabase's *pooled* ("Transaction" mode,
# port 6543) connection string, not the direct one -- serverless functions
# open a fresh DB connection per invocation, so PgBouncer needs to be in
# front of it. Accepts both "postgresql://" and "postgres://" (normalized
# automatically).
DATABASE_URL=

# Gates `create_all` + the ownership-column migration + the sample-data
# seeders that normally run on every startup (see main.py / database.py).
# Leave "true" until you've confirmed the deployment's schema is current,
# then set to "false" to skip that DB round-trip on every serverless cold
# start.
RUN_STARTUP_TASKS=true

# ---------------------------------------------------------------------
# Auth (app/security.py)
# ---------------------------------------------------------------------
AUTH_SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# When "true", password-reset/email-verification "request" endpoints return
# the raw token directly in the JSON response instead of only emailing it --
# handy for local testing without an SMTP server. Leave unset in production.
AUTH_DEBUG_EXPOSE_TOKENS=false

# ---------------------------------------------------------------------
# CORS (app/main.py)
# ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://your-app-git-preview-you.vercel.app
# Leave blank during local dev (defaults to "*", wide open).
# Not needed if deployed via the root vercel.json's Vercel Services setup
# (frontend + backend share one domain there, so the browser never makes a
# cross-origin request in the first place) -- only matters if the backend
# is deployed as its own separate project/domain instead.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# File uploads / Supabase Storage (app/uploads.py)
# ---------------------------------------------------------------------
# Leave both blank to store uploads on local disk (backend/uploads/) --
# fine for local dev, but NOT usable on Vercel (its filesystem is
# read-only outside /tmp, and /tmp doesn't persist between invocations).
# Set both to route Study Hub attachments, resource-library files, and
# AI Workspace project-zip snapshots through Supabase Storage instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for everyday attachments/resources (must already exist
# and be public).
SUPABASE_STORAGE_BUCKET=attachments
# Separate bucket for AI Workspace project-zip snapshots (larger files,
# different retention story). Falls back to SUPABASE_STORAGE_BUCKET if
# left blank, so a single-bucket setup still works.
SUPABASE_ZIPS_BUCKET=project-zips

# ---------------------------------------------------------------------
# SMTP (app/email_utils.py) -- powers email verification + password reset mail.
# Leave SMTP_HOST/SMTP_FROM_EMAIL blank to disable sending (falls back to
# AUTH_DEBUG_EXPOSE_TOKENS behavior above).
# ---------------------------------------------------------------------
# Gmail example: host=smtp.gmail.com, port=587, encryption=starttls,
# username=you@gmail.com, password=an App Password (NOT your normal
# Gmail password -- generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification to be enabled on the account).
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Productivity Dashboard

# The frontend's origin -- used to build the links inside verification /
# password-reset emails (e.g. {FRONTEND_URL}/verify-email?token=...).
# Set to your real Vercel frontend URL in production.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Google Sign-In (routers/auth.py POST /api/auth/google)
# ---------------------------------------------------------------------
# OAuth 2.0 Web Client ID from https://console.cloud.google.com/apis/credentials
# (create an "OAuth client ID" of type "Web application"; add your frontend
# origin(s), e.g. https://your-app.vercel.app, under "Authorized JavaScript
# origins" -- do this for the production domain AND any preview domains you
# test Google sign-in on).
# Must match the frontend's VITE_GOOGLE_CLIENT_ID exactly -- it's the same ID
# used on both sides, just verified here instead of trusted blindly.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------
# Web Push (app/routers/push.py) -- background delivery for the installed
# PWA (phone notifications with every browser/app closed). Leave blank to
# disable: the Settings page hides its push controls and /api/push/dispatch
# answers 503.
# ---------------------------------------------------------------------
# Generate ONCE with `npx web-push generate-vapid-keys` -- regenerating
# later invalidates every existing subscription. VAPID_PUBLIC_KEY here must
# equal the frontend's VITE_VAPID_PUBLIC_KEY (same key, both sides).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID issuer contact (mailto: or https:// URL per spec) -- push services
# reach out here only if you ever abuse them.
VAPID_SUBJECT=mailto:you@example.com
# Shared secret guarding POST/GET /api/push/dispatch (any long random
# string). Your uptime-bot monitor passes it as ?key=... and/or the GitHub
# Actions fallback sends it as an x-dispatch-secret header. Never commit it.
DISPATCH_SECRET=
